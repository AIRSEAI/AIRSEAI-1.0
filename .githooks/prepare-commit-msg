#!/bin/sh
#
# Automatically appends a DCO "Signed-off-by" trailer to every commit message.
#
# Enable it once per clone with:
#     git config core.hooksPath .githooks
#
# This makes GUI clients (Sourcetree, GitKraken, VS Code, ...) sign off commits
# even though they do not pass the `-s` flag to git.

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

# Merge and squash messages are generated by git itself; leave them alone.
case "$COMMIT_SOURCE" in
  merge|squash) exit 0 ;;
esac

NAME=$(git config user.name)
EMAIL=$(git config user.email)

if [ -z "$NAME" ] || [ -z "$EMAIL" ]; then
  echo "prepare-commit-msg: user.name and user.email must be set to sign off commits." >&2
  echo "  git config user.name  \"Your Name\"" >&2
  echo "  git config user.email \"you@example.com\"" >&2
  exit 1
fi

git interpret-trailers \
  --in-place \
  --if-exists addIfDifferent \
  --trailer "Signed-off-by: $NAME <$EMAIL>" \
  "$COMMIT_MSG_FILE"
