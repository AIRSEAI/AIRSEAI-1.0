{
  "schema_version": "0.2-v11",
  "paper_claim": "For stateful embodied AI, hardware state lifetime is a property of the policy execution context, not of the model graph alone.",
  "generic_nested_domains": [
    "operator_execution",
    "policy_internal_iteration",
    "policy_or_control_invocation",
    "episode"
